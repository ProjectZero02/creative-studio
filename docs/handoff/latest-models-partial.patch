+def generate_video_any_model(request: VideoGenerationRequest) -> list[str]:
+    """Run a Veo-shaped request on Gemini Omni or Veo, whichever it names.
+
+    Pages written for Veo build a ``VideoGenerationRequest``. When its
+    ``model_version_id`` is a Gemini Omni model, the request is translated to
+    Omni (mode from the inputs: references, first + last frame, one image, or
+    text; length, aspect ratio and resolution kept inside the model's limits).
+    Any other id goes to Veo unchanged, so the Veo path stays one setting away.
+
+    Returns:
+        The GCS URIs of the generated clips (Omni returns at most one).
+
+    """
+    omni_version = omni_version_id(request.model_version_id)
+    omni = get_omni_model_config(omni_version or request.model_version_id)
+    if not omni:
+        video_uris, _ = generate_video(request)
+        return list(video_uris or [])
+
+    if request.r2v_references:
+        mode = "ref2v"
+    elif request.reference_image_gcs and request.last_reference_image_gcs:
+        mode = "first_last"
+    elif request.reference_image_gcs:
+        mode = "i2v"
+    else:
+        mode = "t2v"
+    if mode not in omni.supported_modes:
+        raise GenerationError(f"{omni.display_name} does not support '{mode}'.")
+
+    aspect = request.aspect_ratio
+    if aspect not in omni.supported_aspect_ratios:
+        aspect = omni.supported_aspect_ratios[0]
+    resolution = request.resolution
+    if resolution not in omni.resolutions:
+        resolution = "720p" if "720p" in omni.resolutions else omni.resolutions[0]
+
+    gcs_uri, _ = generate_omni_video(
+        OmniVideoGenerationRequest(
+            prompt=request.prompt,
+            duration_seconds=clamp_duration(omni.version_id, request.duration_seconds),
+            aspect_ratio=aspect,
+            resolution=resolution,
+            omni_mode=mode,
+            model_version_id=omni.version_id,
+            reference_image_gcs=request.reference_image_gcs,
+            reference_image_mime_type=request.reference_image_mime_type,
+            last_reference_image_gcs=request.last_reference_image_gcs,
+            last_reference_image_mime_type=request.last_reference_image_mime_type,
+            r2v_references=request.r2v_references,
+        ),
+    )
+    return [gcs_uri] if gcs_uri else []
+
